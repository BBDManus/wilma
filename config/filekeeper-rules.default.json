{
  "skill": "simple-filekeeper",
  "version": "1.0.0",
  "index_path": "FILE-INDEX.md",
  "hooks": {
    "update_trigger": ["Write", "Edit"],
    "verify_trigger": ["Glob", "Grep", "Read"]
  },
  "exclude_dirs": [
    ".claude",
    ".git"
  ],
  "exclude_paths": [
    "resources/tools",
    "resources/scripts"
  ],
  "index_exempt_files": [
    "FILE-INDEX.md"
  ],
  "sections": {
    "auto_create": true,
    "group_by": "top_level_folder"
  },
  "behavior": {
    "mode": "incremental",
    "never_rebuild_automatically": true,
    "missing_index_action": "warn_and_exit"
  }
}
