{
  "description": "wilma automation hooks — file index maintenance and worklog capture",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File \"$CLAUDE_PLUGIN_ROOT/hooks/scripts/update-file-index.ps1\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Glob|Grep|Read",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File \"$CLAUDE_PLUGIN_ROOT/hooks/scripts/verify-file-index.ps1\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File \"$CLAUDE_PLUGIN_ROOT/hooks/scripts/append-worklog.ps1\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
